    }
    function actSetMax() {
        var dm = getDM(); if (!dm) return;
        if (!confirm('money / gems を 99999999999 で保存します（戻せません）。実行しますか？')) {
            log('キャンセル', 'warn'); return;
        }
        dm.state.stats.money = 99999999999;
