    // ===== ログ =====
    var logEl = root.querySelector('[data-log]');
    function log(msg, type) {
        if (!logEl) return;
        var line = document.createElement('div');
        line.className = 'chg-log-' + (type || 'info');
        line.textContent = '[' + new Date().toLocaleTimeString() + '] ' + msg;
        logEl.appendChild(line);
