    root.addEventListener('click', function (e) {
        var t = e.target;
        if (!t || !t.dataset || !t.dataset.action) return;
        var a = t.dataset.action;
        if (a === 'build') actBuild();
        else if (a === 'menu') actMenu();
        else if (a === 'select-state') actSelectState();
        else if (a === 'god-mode') actGodMode();
        else if (a === 'auto-v') actAutoV();
        else if (a === 'apply-params') actApplyParams();
        else if (a === 'cam-expanded') applyCameraPreset('expanded');
        else if (a === 'cam-wide') applyCameraPreset('wide');
        else if (a === 'cam-normal') applyCameraPreset('normal');
        else if (a === 'show') actShow();
        else if (a === 'set-custom') actSetCustom();
        else if (a === 'set-max') actSetMax();
        else if (a === 'dump') actDump();
        else if (a === 'reload') actReload();
        else if (a === 'minimize') root.classList.toggle('chg-minimized');
        else if (a === 'close') setOpen(false);
        else if (a === 'destroy') destroy();
    });

    // ===== リサイズ時の位置調整 =====
    function onResize() {
        if (openBtn.style.display !== 'none') {
            var r = openBtn.getBoundingClientRect();
            var p = clampPos(r.left, r.top, openBtn);
            openBtn.style.left = p.x + 'px';
            openBtn.style.top = p.y + 'px';
            savePos(LS_POS_OPEN, p.x, p.y);
        }
        if (root.style.display !== 'none') {
            var r2 = root.getBoundingClientRect();
            var p2 = clampPos(r2.left, r2.top, root);
            root.style.left = p2.x + 'px';
            root.style.top = p2.y + 'px';
            savePos(LS_POS_GUI, p2.x, p2.y);
        }
    }
    window.addEventListener('resize', onResize);
    requestAnimationFrame(onResize);

    // ===== カメラキャプチャコールバック =====
    function onCameraCapture() {
        log('OrbitControls をキャプチャ', 'ok');
        captureCameraDefaults();
        updateCameraStatus();
    }

    // ===== 完全削除 =====
    function destroy() {
        window.removeEventListener('resize', onResize);
        if (root.parentNode) root.parentNode.removeChild(root);
        if (openBtn.parentNode) openBtn.parentNode.removeChild(openBtn);
        if (styleEl.parentNode) styleEl.parentNode.removeChild(styleEl);
        if (window.__cogmedPurpleObserver) window.__cogmedPurpleObserver.disconnect();
        var overrideStyle = document.getElementById('cogmed-purple-override');
        if (overrideStyle) overrideStyle.remove();
        if (autoVInterval) clearInterval(autoVInterval);
        
        if (window.AutoPilot && originalGetResponseType) {
             window.AutoPilot.getResponseType = originalGetResponseType;
        }
        
        window.__cogmedHackGui = null;
    }

    window.__cogmedHackGui = {
        destroy: destroy,
        root: root,
        openBtn: openBtn,
        onCameraCapture: onCameraCapture,
        applyCameraPreset: applyCameraPreset,
        cameraState: cameraState
    };

    updateCameraStatus();
    log(TITLE + ' 起動', 'ok');
    log('テーマカラーを紫 (#9333ea) に強制適用しました', 'ok');
