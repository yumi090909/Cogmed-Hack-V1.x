    // ===== DataManager / Vue 探索 =====
    function getDM() {
        var dm = window.Datamanager;
        if (!dm) { log('Datamanager なし', 'err'); return null; }
        if (!dm.state) { log('dm.state なし', 'err'); return null; }
        if (!dm.state.stats) { log('dm.state.stats なし', 'err'); return null; }
        return dm;
    }
    function findTrainingComponent() {
        var appEl = document.querySelector('#app');
        if (!appEl) return null;
        var rootVNode = appEl._vnode;
        if (!rootVNode || !rootVNode.component) return null;
        var rootInst = rootVNode.component;
        var found = null;
        function walk(vnode, depth) {
            if (!vnode || depth > 500 || found) return;
            if (vnode.component) {
                var inst = vnode.component;
                if (inst.proxy && typeof inst.proxy.trainingState === 'string') { found = inst; return; }
                walk(inst.subTree, depth + 1);
            }
            if (Array.isArray(vnode.children)) {
                for (var i = 0; i < vnode.children.length; i++) walk(vnode.children[i], depth + 1);
            }
            if (vnode.suspense) walk(vnode.suspense.activeBranch, depth + 1);
        }
        walk(rootInst.subTree, 0);
        if (!found && rootInst.proxy && typeof rootInst.proxy.trainingState === 'string') found = rootInst;
        return found;
    }

    // ===== Auto Training Logic =====
    
    // GOD MODE (Fixed: Set strategy.type to "correct")
    function actGodMode() {
        if (window.AutoPilot) {
            log('AutoPilot detected. Setting strategy to "correct"...', 'info');
            
            // Set strategy to "correct" for GOD MODE
            window.AutoPilot.strategy = { type: "correct" };
            
            if (!window.AutoPilot.isActive) {
                window.AutoPilot.isActive = true;
                log('AutoPilot activated.', 'ok');
            }
            
            log('%c[Cogmed Hack] GOD MODE ENABLED: All taps are now CORRECT', 'color: #ff0000; font-weight: bold; font-size: 14px;', 'ok');
        } else {
            log('AutoPilot not found. Make sure you are in a training session.', 'err');
        }
    }

    // AUTO V2 (Stable Mode) - Fixed Logic using AutoPilot Hook
    var autoVInterval = null;
    var autoVParams = {
        errorRate: 46, // Default 46%
        delayMs: 1300  // Default 1.3s
    };
    var originalGetResponseType = null;

    function actApplyParams() {
        var errorRateInput = root.querySelector('[data-field="error-rate"]');
        var delayInput = root.querySelector('[data-field="delay-time"]');
        
        var er = parseFloat(errorRateInput.value);
        if (isNaN(er) || er < 0) er = 0;
        if (er > 100) er = 100;
        autoVParams.errorRate = er;

        var dl = parseFloat(delayInput.value);
        if (isNaN(dl) || dl < 0) dl = 1.3;
        autoVParams.delayMs = dl * 1000;

        log('✅ パラメータを更新しました (ミス率: ' + autoVParams.errorRate + '%, 遅延: ' + dl + 's)', 'ok');
    }

    function actAutoV() {
        if (autoVInterval) {
            clearInterval(autoVInterval);
            autoVInterval = null;
            
            // Restore original AutoPilot behavior if hooked
            if (window.AutoPilot && originalGetResponseType) {
                window.AutoPilot.getResponseType = originalGetResponseType;
                originalGetResponseType = null;
                log('AutoPilot restored to original.', 'info');
            }
            
            // Reset speed factor
            if (window.AutoPilot) {
                window.AutoPilot.speedFactor = 0.001; // Default fast
                window.AutoPilot.clickDelay = 200;    // Default fast
            }

            log('⏹ オートトレーニングV2 を停止しました', 'warn');
            return;
        }

        if (!window.AutoPilot) {
            log('AutoPilot not found. Start a training first.', 'err');
            return;
        }

        // Apply params on start as well
        actApplyParams();

        // Hook AutoPilot
        if (!originalGetResponseType) {
            originalGetResponseType = window.AutoPilot.getResponseType;
        }

        // Set strategy to "random" for AUTO V2
        window.AutoPilot.strategy = { 
            type: "random", 
            maxLevel: 10, 
            seed: Math.random() * 1000 
        };

        window.AutoPilot.getResponseType = function(level) {
            // Determine if we should make a mistake based on configured rate
            var roll = Math.random() * 100;
            if (roll < autoVParams.errorRate) {
                // Intentional Mistake
                // Randomly choose between Major and Minor error
                return Math.random() > 0.5 ? "ERROR_MAJOR" : "ERROR_MINOR";
            }
            return "CORRECT";
        };

        // Configure Delay
        window.AutoPilot.clickDelay = autoVParams.delayMs;
        window.AutoPilot.speedFactor = 1.0; // Real-time scale

        if (!window.AutoPilot.isActive) {
            window.AutoPilot.isActive = true;
        }

        log('▶ オートトレーニングV2 を開始 (AutoPilot Sync)', 'ok');
        log('  ミス率: ' + autoVParams.errorRate + '% / 遅延: ' + (autoVParams.delayMs/1000) + 's', 'info');

        // Keep-alive loop
        autoVInterval = setInterval(function() {}, 1000);
    }

    // ===== 各操作 =====
    function actBuild() {
        var found = findTrainingComponent();
        if (!found) { log('trainingState 保有コンポーネント未発見', 'err'); return; }
        log('切替前: ' + found.proxy.trainingState, 'info');
        try {
            if (typeof found.proxy.onStartBuildMode === 'function') found.proxy.onStartBuildMode();
            else found.proxy.trainingState = 'Build';
            log('✅ 建築モード: ' + found.proxy.trainingState, 'ok');
        } catch (e) { log('失敗: ' + e.message, 'err'); }
    }
    function actMenu() {
        var found = findTrainingComponent();
        if (!found) { log('trainingState 保有コンポーネント未発見', 'err'); return; }
        log('切替前: ' + found.proxy.trainingState, 'info');
        found.proxy.trainingState = 'Menu';
        log('✅ Menu へ戻しました', 'ok');
        log('※ 3Dの箱アイコンは戻りません。完全リセットはリロード推奨', 'warn');
    }
    function actSelectState() {
        var found = findTrainingComponent();
        if (!found) { log('trainingState 保有コンポーネント未発見', 'err'); return; }
        if (typeof found.proxy.selectTrainingState !== 'function') {
            log('selectTrainingState メソッドなし', 'err'); return;
