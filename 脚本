    const RGB_RE = /rgb\(\s*18\s*,\s*184\s*,\s*221\s*\)/gi;
    const PROPS = ['backgroundColor', 'color', 'fill', 'borderColor', 'background'];
    function walkRule(rule) {
        if (rule.cssRules) { for (const child of rule.cssRules) walkRule(child); return; }
        if (!rule.style) return;
        for (const prop of PROPS) {
            const val = rule.style[prop];
            if (!val) continue;
            if (RGB_RE.test(val) || HEX_RE.test(val)) {
                HEX_RE.lastIndex = 0; RGB_RE.lastIndex = 0;
                rule.style[prop] = val.replace(RGB_RE, NEW_COLOR).replace(HEX_RE, NEW_COLOR);
            }
            HEX_RE.lastIndex = 0; RGB_RE.lastIndex = 0;
        }
    }
